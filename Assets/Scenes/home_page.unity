  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Instrukcja gry:\nGracz zwiedza muzeum, klikaj\u0105c na tabliczki obok
    eksponat\xF3w. Na ko\u0144cu sali spotyka smutne dzieci przy tabliczce s\u0142onia
    le\u015Bnego. Aby im pom\xF3c, trzeba klikn\u0105\u0107 na rysunek s\u0142onia
    i przenie\u015B\u0107 si\u0119 w przesz\u0142o\u015B\u0107.\n\nW drugiej scenie,
    w roku 1962, gracz zbiera ko\u015Bci s\u0142onia. Gdy szkielet jest gotowy, wraca
    do muzeum, gdzie widzi kompletnego s\u0142onia i szcz\u0119\u015Bliwe dzieci.\n\n   "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b764d2234ba2d4856b64b76c920bd096, type: 2}
